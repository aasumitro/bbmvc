---
// Google Analytics, only for a visitor who said yes to the cookie banner
// (components/site/ConsentBanner.astro): started on the answer, or on every
// page after it; a later no stops it.
---

<script>
  import { startAnalytics, stopAnalytics } from '@/lib/analytics'
  import { onConsent, readConsent } from '@/lib/consent'

  function apply() {
    const consent = readConsent()
    if (consent === 'granted') startAnalytics()
    else if (consent === 'denied') stopAnalytics()
  }

  apply()
  onConsent(apply)
</script>
