---
import { Image } from 'astro:assets'
import emblem from '@/assets/emblem.png'
import AccountSlot from './AccountSlot.astro'
import NavLink from './NavLink.astro'

interface Props {
  path?: string // the page's path: marks the open section
  overlay?: boolean // laid over the home page's full-screen scene, on a fade instead of a bar
}

const { path, overlay = false } = Astro.props
---

<header class={overlay ? 'absolute inset-x-0 top-0 z-20 bg-linear-to-b from-black/70 to-transparent' : 'border-b border-line bg-base'}>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-5 px-4 sm:gap-8 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="Scrapyard, home">
      <Image src={emblem} alt="" widths={[40, 80]} sizes="40px" class="h-6 w-auto" />
      <span class="hidden font-display text-xl font-semibold tracking-wide sm:inline">Scrapyard</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex gap-5 sm:gap-7">
        <li><NavLink href="/docs" path={path}>Guide</NavLink></li>
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-4 sm:gap-6">
      <AccountSlot />
      <a href="/play" class="button-primary px-4 py-2 text-xs sm:px-5">Play</a>
    </div>
  </div>
</header>
