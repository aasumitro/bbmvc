---
// The header's account corner: "Log in", or the signed-in player's name. The
// build can't know who is signed in (the session lives in the browser), so
// the space stays empty until the script has looked, rather than flash
// "Log in" at someone who is.
---

<span data-account-slot class="contents">
  <span data-unknown class="w-16" aria-hidden="true"></span>
  <a data-signed-out href="/login" class="label text-neutral-300 hover:text-white" hidden>Log in</a>
  <a
    data-signed-in
    href="/account"
    title="Your account"
    class="label max-w-36 truncate text-neutral-300 normal-case tracking-[0.06em] hover:text-white"
    hidden></a>
</span>

<script>
  import { signedInName } from '@/lib/nakama/claims'
  import { readStored, subscribe } from '@/lib/nakama/storage'

  // Guests have no account page to open: they get "Log in" too.
  function show() {
    const name = signedInName(readStored())
    for (const slot of document.querySelectorAll('[data-account-slot]')) {
      slot.querySelector('[data-unknown]')?.remove()
      const signedIn = slot.querySelector<HTMLElement>('[data-signed-in]')!
      signedIn.textContent = name
      signedIn.hidden = !name
      slot.querySelector<HTMLElement>('[data-signed-out]')!.hidden = !!name
    }
  }

  show()
  subscribe(show)
</script>
